<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- Lecture seule de la banque de vignettes SQLite du lecteur PC (Multivid VR),
       pour resservir au casque une vignette déjà générée sans repasser par ffmpeg. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>

  <!-- Bundle the ffmpeg toolchain next to the app so live transcode works on any
       machine without a system-wide ffmpeg. Copied to <output>\tools\. -->
  <ItemGroup>
    <Content Include="tools\ffmpeg.exe" Condition="Exists('tools\ffmpeg.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\ffmpeg.exe</Link>
    </Content>
    <Content Include="tools\ffprobe.exe" Condition="Exists('tools\ffprobe.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\ffprobe.exe</Link>
    </Content>
  </ItemGroup>

</Project>
